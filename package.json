{
  "name": "dsh-system-ca",
  "version": "1.0.0",
  "description": "Make the DeepSeek Harness host trust the OS certificate store, so web_fetch works through local MITM proxies, accelerators and corporate roots.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tls",
    "certificate",
    "proxy"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.15"
  }
}
